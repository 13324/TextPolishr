<Window x:Class="TextPolishr.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Text Polishr" Width="1080" Height="800" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#F7F8F5" Foreground="#17212B"
        FontFamily="Segoe UI Variable Text" FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="70" ResizeBorderThickness="6" CornerRadius="14"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#F7F8F5" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Raised" Color="#F4F6F3" />
        <SolidColorBrush x:Key="Hover" Color="#E9EDE8" />
        <SolidColorBrush x:Key="Line" Color="#D2DAD3" />
        <SolidColorBrush x:Key="Ink" Color="#17212B" />
        <SolidColorBrush x:Key="Muted" Color="#435260" />
        <SolidColorBrush x:Key="Quiet" Color="#647482" />
        <SolidColorBrush x:Key="Signal" Color="#B64026" />
        <SolidColorBrush x:Key="SignalSoft" Color="#F8E7E1" />
        <DataTemplate x:Key="CatMark">
            <Viewbox Stretch="Uniform">
                <Canvas Width="48" Height="48">
                    <Path Data="M7,23 L8,9 L18,15 L29,14 L40,8 L40,24 C40,35 33,42 24,42 C14,42 7,35 7,23 Z" Fill="#FEFEFB" Stroke="#17212B" StrokeThickness="2.6" StrokeLineJoin="Round" />
                    <Ellipse Canvas.Left="16" Canvas.Top="24" Width="3" Height="4" Fill="#17212B" /><Ellipse Canvas.Left="30" Canvas.Top="24" Width="3" Height="4" Fill="#17212B" />
                    <Ellipse Canvas.Left="22" Canvas.Top="29" Width="4" Height="2.5" Fill="#EF9B93" />
                    <Ellipse Canvas.Left="11" Canvas.Top="30" Width="7" Height="3" Fill="#F2B5AD" Opacity=".7" /><Ellipse Canvas.Left="30" Canvas.Top="30" Width="7" Height="3" Fill="#F2B5AD" Opacity=".7" />
                    <Ellipse Canvas.Left="32" Canvas.Top="32" Width="11" Height="12" Fill="#FEFEFB" Stroke="#17212B" StrokeThickness="2.6" />
                    <Line X1="35" Y1="37" X2="35" Y2="39" Stroke="#17212B" StrokeThickness="2" StrokeStartLineCap="Round" /><Line X1="38" Y1="36" X2="38" Y2="39" Stroke="#17212B" StrokeThickness="2" StrokeStartLineCap="Round" /><Line X1="41" Y1="37" X2="41" Y2="39" Stroke="#17212B" StrokeThickness="2" StrokeStartLineCap="Round" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Signal}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="28" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="PresetInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Signal}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PresetCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Signal}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Quiet}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Text="⌄" Foreground="{StaticResource Muted}" FontSize="16" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Margin="0,-3,13,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Muted}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBox x:Name="PART_EditableTextBox" Background="Transparent" BorderThickness="0"
                                     Margin="3,2,38,2" Padding="9,6" VerticalContentAlignment="Center" Visibility="Hidden" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280" Padding="5">
                                    <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource Signal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Hover}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SignalSoft}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4" Background="{StaticResource Raised}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,9,0">
                                <TextBlock x:Name="CheckMark" Text="✓" Foreground="White" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource Signal}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Signal}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#AEB8AF" CornerRadius="5" Margin="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Signal}" />
            <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="15,12" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="13,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SignalSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource Canvas}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                    <ContentControl Width="38" Height="38" ContentTemplate="{StaticResource CatMark}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Text Polishr" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="TEXT TRANSFORMATION" Style="{StaticResource Eyebrow}" FontSize="10" Foreground="{StaticResource Quiet}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="HeaderPageTitle" Grid.Column="1" Text="General" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="28,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="48" Height="44" Style="{StaticResource NavButton}" Click="Minimize_Click" />
                    <Button Content="×" Width="48" Height="44" Style="{StaticResource NavButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Panel}" Padding="18,24">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Quiet}" Margin="13,0,0,12" />
                        <Button x:Name="GeneralNav" Content="General" Style="{StaticResource NavButton}" Click="GeneralNav_Click" />
                        <Button x:Name="ModelNav" Content="Model" Style="{StaticResource NavButton}" Click="ModelNav_Click" />
                        <Button x:Name="PresetsNav" Content="Presets" Style="{StaticResource NavButton}" Click="PresetsNav_Click" />
                        <Border Height="1" Background="{StaticResource Line}" Margin="13,22,13,18" />
                        <TextBlock Text="Your text is sent only when you trigger a preset. Settings remain local."
                                   Foreground="{StaticResource Quiet}" FontSize="11" TextWrapping="Wrap" Margin="13,0" LineHeight="17" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource Line}" />

                <Grid Grid.Column="2" Margin="36,30,36,24">
                    <Grid x:Name="GeneralPage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="GENERAL" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Behavior and limits" Style="{StaticResource PageTitle}" Margin="0,7,0,4" />
                            <TextBlock Text="Configure the shortcut, selection limit, and request timeout." Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Preset menu shortcut" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="MenuShortcutBox" Style="{StaticResource PresetInput}" PreviewKeyDown="ShortcutBox_PreviewKeyDown" GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                                             ToolTip="Click, then press the complete key combination. Backspace clears it." />
                                    <TextBlock Text="Click the field, then press the complete key combination. Backspace clears it." Foreground="{StaticResource Quiet}" FontSize="11" Margin="2,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="Maximum characters" Style="{StaticResource FieldLabel}"/><TextBlock Text="Default: 10,000" Foreground="{StaticResource Quiet}" FontSize="11"/></StackPanel>
                                <TextBox x:Name="CharacterLimitBox" Grid.Row="2" Grid.Column="1" />
                                <StackPanel Grid.Row="4" VerticalAlignment="Center"><TextBlock Text="Request timeout" Style="{StaticResource FieldLabel}"/><TextBlock Text="Seconds before aborting" Foreground="{StaticResource Quiet}" FontSize="11"/></StackPanel>
                                <TextBox x:Name="TimeoutBox" Grid.Row="4" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ModelPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="MODEL" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Provider &amp; model" Style="{StaticResource PageTitle}" Margin="0,7,0,4" />
                            <TextBlock Text="One global model, with optional overrides for individual presets." Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProviderCombo" Grid.Column="1" SelectionChanged="ProviderCombo_SelectionChanged" />
                                <TextBlock Grid.Row="2" Text="Base URL" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="BaseUrlBox" Grid.Row="2" Grid.Column="1" />
                                <TextBlock Grid.Row="4" Text="API key" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <PasswordBox x:Name="ApiKeyBox" Grid.Row="4" Grid.Column="1" />
                                <TextBlock Grid.Row="6" Text="Model" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ModelCombo" Grid.Row="6" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" />
                                <Button x:Name="RefreshModelsButton" Grid.Row="8" Grid.Column="1" Content="Refresh available models" HorizontalAlignment="Left"
                                        Style="{StaticResource ButtonBase}" Click="RefreshModels_Click" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="PresetsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Preset configuration" Style="{StaticResource PageTitle}" Margin="0,7,0,4" />
                            <TextBlock Text="The prompt controls the result. Shortcut and model options are optional." Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel Margin="4,2,4,10">
                                        <TextBlock Text="PRESETS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Quiet}" VerticalAlignment="Center" />
                                        <Button Content="＋" Width="34" Height="32" Padding="0" HorizontalAlignment="Right" Style="{StaticResource ButtonBase}" Click="AddPreset_Click" />
                                    </DockPanel>
                                    <ListBox x:Name="PresetList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="PresetList_SelectionChanged" />
                                    <Button Grid.Row="2" Content="Delete preset" Foreground="#B42337" Style="{StaticResource ButtonBase}" Margin="2,10,2,2" Click="DeletePreset_Click" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <ScrollViewer x:Name="PresetScroll" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Preset name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PresetNameBox" Style="{StaticResource PresetInput}" />
                                        <DockPanel Margin="0,18,0,7">
                                            <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <TextBlock Text="${output}  ·  ${instruction}" Foreground="{StaticResource Quiet}" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBox x:Name="PresetPromptBox" Style="{StaticResource PresetInput}" Height="180" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" FontSize="13" />
                                        <Expander x:Name="PresetAdvancedOptions" Header="Advanced options" Margin="0,18,0,0">
                                            <StackPanel Margin="0,14,0,0">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Provider override (optional)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PresetProviderCombo" Style="{StaticResource PresetCombo}" /></StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Model override (optional)" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox x:Name="PresetModelBox" Style="{StaticResource PresetInput}" />
                                                        <TextBlock Text="Leave blank to use the global model. Enter an exact model ID only for a different model." Foreground="{StaticResource Quiet}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Direct shortcut" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" />
                                                <TextBox x:Name="PresetShortcutBox" Style="{StaticResource PresetInput}" PreviewKeyDown="ShortcutBox_PreviewKeyDown" GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                                                         ToolTip="Click, then press the complete key combination. Backspace clears it." />
                                                <TextBlock Text="Click the field, then press the complete key combination. Backspace clears it." Foreground="{StaticResource Quiet}" FontSize="11" Margin="2,6,0,0" />
                                                <CheckBox x:Name="PresetShowInMenuCheck" Content="Show in selection menu" Margin="0,18,0,0" />
                                            </StackPanel>
                                        </Expander>
                                        <Button x:Name="ApplyPresetButton" Content="Apply preset" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Click="ApplyPreset_Click" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" Text="Changes are stored locally" Foreground="{StaticResource Quiet}" VerticalAlignment="Center" Margin="26,0" />
                <Button x:Name="SaveButton" Grid.Column="1" Content="Save changes" Style="{StaticResource PrimaryButton}" Margin="0,14,24,14" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
